# ── Backend (Render) ──────────────────────────────────────────────────────
FB_TOKEN=your_meta_access_token_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
FRONTEND_URL=https://your-app.vercel.app

# ── Frontend (Vercel) ──────────────────────────────────────────────────────
VITE_API_URL=https://your-backend.onrender.com

# Backend runtime: Node.js 24+
# Server-only write password; never prefix with VITE_.
DASHBOARD_WRITE_TOKEN=replace_with_a_long_random_password
# Use the persistent disk mount path on Render, not its ephemeral filesystem.
DATA_DIR=./data
META_API_VERSION=v25.0
